{
 "name":"railsaathi", "main":"backend/worker.mjs", "compatibility_date":"2026-09-01",
 "assets":{"directory":"./web","binding":"ASSETS","run_worker_first":["/api/*","/snapshots/*"]},
 "d1_databases":[{"binding":"DB","database_name":"railsaathi","database_id":"REPLACE_WITH_D1_DATABASE_ID"}],
 "r2_buckets":[{"binding":"SNAPSHOTS","bucket_name":"railsaathi-positions"}],
 "vars":{"SNAPSHOT_BASE_URL":"https://positions.YOUR-DOMAIN.example"},
 "triggers":{"crons":["*/5 * * * *"]}
}
